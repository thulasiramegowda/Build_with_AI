{
  "name": "codepulse",
  "version": "1.0.0",
  "description": "AI-powered GitHub repository intelligence and code collaboration platform",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "vitest run",
    "lint": "tsc --noEmit --project server && tsc --noEmit --project client"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "concurrently": "^8.2.2",
    "supertest": "^7.3.1",
    "vitest": "^2.1.3"
  }
}
