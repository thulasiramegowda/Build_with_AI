# CodePulse Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini API Key for dynamic AI explanations and patch generation
# If not provided, CodePulse operates with full deterministic heuristic fallbacks
GEMINI_API_KEY=

# Optional: GitHub App Configuration for Live GitHub Mode
