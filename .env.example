# =============================================================================
# CodePulse Environment Configuration Template
# =============================================================================
# Copy this file to .env and populate the required credentials:
# cp .env.example .env
#
# NOTE: Never commit your actual .env file or credentials to source control.
# =============================================================================

# Server Environment
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# -----------------------------------------------------------------------------
# 1. MySQL Database Configuration
# -----------------------------------------------------------------------------
# CodePulse uses MySQL for persisting user sessions, repository metadata,
# AST analysis runs, and detected API contract findings.
#
# If MySQL is not running or credentials are not supplied, CodePulse gracefully
# falls back to an isolated in-memory store so unit tests run independently.
#
# Quick setup:
#   1. Start MySQL daemon (e.g. systemctl start mysql, or Docker: docker run -p 3306:3306 -e MYSQL_ROOT_PASSWORD=secret -e MYSQL_DATABASE=codepulse -d mysql:8)
#   2. Execute schema migration: mysql -u root -p codepulse < server/src/db/schema.sql
# -----------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=codepulse
MYSQL_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# 2. GitHub OAuth App Credentials
# -----------------------------------------------------------------------------
# Register an OAuth Application on GitHub:
#   1. Navigate to: https://github.com/settings/developers -> OAuth Apps -> New OAuth App
#   2. Application name: CodePulse
#   3. Homepage URL: http://localhost:5173
#   4. Authorization callback URL: http://localhost:3001/api/auth/github/callback
#   5. Generate a Client Secret and copy both values below:
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# -----------------------------------------------------------------------------
# 3. Google Gemini AI Engine Configuration
# -----------------------------------------------------------------------------
# Generates natural language architecture explanations and context-aware diff patches.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
#
# If unset, CodePulse operates using its built-in deterministic heuristic rule engine.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# 4. Session Security & Cookie Configuration
# -----------------------------------------------------------------------------
# CodePulse manages authentication via secure HttpOnly, SameSite=Lax cookies.
# Tokens are NEVER passed via URL query strings or stored in client localStorage.
# -----------------------------------------------------------------------------
SESSION_COOKIE_NAME=codepulse_session
SESSION_TTL_MS=604800000
